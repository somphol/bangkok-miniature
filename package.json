{
  "name": "bangkok-miniature",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node scripts/inline-build.mjs",
    "test": "tsx tests/plan.test.ts && tsx tests/geometry.test.ts",
    "verify": "npm run build:single && node scripts/verify.mjs",
    "shot": "npm run build && node scripts/shot.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright-core": "1.64.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
